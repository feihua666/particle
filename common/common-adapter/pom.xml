<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>common</artifactId>
        <groupId>com.particle</groupId>
        <version>6.0.1-beta-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>common-adapter</artifactId>

    <description>
        DDD 架构中的通用适配层模块，负责定义系统对外接口形态，
        承载 Web / RPC 等接口的请求接收、参数校验与协议转换，
        将外部请求映射为应用层可理解的调用，不包含具体业务实现与技术基础设施逻辑。
    </description>

    <properties>


    </properties>

    <dependencies>
        <!-- adapter 主要以 controller web 方式提供服务 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <!-- 排除默认的logback，使用log4j2 -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 仅使用 权限 注解 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>


        <!-- 业务组件共享数据依赖 统一添加到这里，主要是应用其操作日志常量-->
        <dependency>
            <groupId>com.particle</groupId>
            <artifactId>component-common</artifactId>
            <version>${particle.version}</version>
        </dependency>
    </dependencies>

</project>
