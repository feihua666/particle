        </dependency>
        <dependency>
            <groupId>com.particle</groupId>
            <artifactId>global-web-mvc-boot-starter</artifactId>
            <version>${particle.version}</version>
        </dependency>
        <!-- 网关中暂不需要 session -->
        <!--<dependency>-->
        <!--    <groupId>com.particle</groupId>-->
        <!--    <artifactId>global-session-boot-starter</artifactId>-->
        <!--    <version>${particle.version}</version>-->
        <!--</dependency>-->

        <!-- 网关中暂不需要 接口文档 -->
        <!--<dependency>-->
